# Discord bot token (Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=

# Right-click -> Copy ID (enable Developer Mode in Discord settings first)
GUILD_ID=
# The channel people post "name: Foo#NA1" in
NAMES_CHANNEL_ID=
# Where monthly winners + bracket polls go. Defaults to the names channel.
#ANNOUNCE_CHANNEL_ID=

# Riot API key (developer.riotgames.com). Use a Personal API key — dev keys expire
# every 24h. With no/expired key the bot still accepts names, just unverified.
RIOT_API_KEY=

# Optional tuning
#DB_PATH=data/names.sqlite3
#TIMEZONE=America/Los_Angeles
#VOTE_EMOJI=👍
#BRACKET_SIZE=16
#ROUND_HOURS=48
# Month-day the Name of the Year bracket auto-starts for the previous year (blank = manual only)
#BRACKET_START=01-02
